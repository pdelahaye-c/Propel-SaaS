# ===========================================
# Propel SaaS - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# -------------------------------------------
# STRIPE CONFIGURATION
# -------------------------------------------
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Price IDs - Create these in Stripe Dashboard > Products
# Starter Plan
STRIPE_PRICE_STARTER_MONTHLY=your_stripe_price_id_here
STRIPE_PRICE_STARTER_YEARLY=your_stripe_price_id_here

# Pro Plan
STRIPE_PRICE_PRO_MONTHLY=your_stripe_price_id_here
STRIPE_PRICE_PRO_YEARLY=your_stripe_price_id_here

# Enterprise Plan
STRIPE_PRICE_ENTERPRISE_MONTHLY=your_stripe_price_id_here
STRIPE_PRICE_ENTERPRISE_YEARLY=your_stripe_price_id_here

# -------------------------------------------
# AI CONFIGURATION
# -------------------------------------------
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------
# DATABASE (for backend)
# -------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/propel_saas

# -------------------------------------------
# AUTHENTICATION (for backend)
# -------------------------------------------
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# -------------------------------------------
# APPLICATION
# -------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# -------------------------------------------
# EMAIL (SendGrid / Resend)
# -------------------------------------------
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM=no-reply@propel.app

# -------------------------------------------
# SMS / WhatsApp (Twilio)
# -------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+33XXXXXXXXX
